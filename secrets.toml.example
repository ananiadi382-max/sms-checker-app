# Это ШАБЛОН. Реальный файл secrets.toml никогда не должен попадать в Git
# (он уже добавлен в .gitignore).
#
# Локально: скопируйте это содержимое в .streamlit/secrets.toml и впишите
# реальные значения.
#
# На Streamlit Cloud: этот же текст (с реальными значениями) вставляется
# в интерфейсе приложения → Settings → Secrets. Ничего коммитить не нужно.

SMSC_LOGIN = "ваш_логин"
SMSC_API_KEY = "ваш_api_ключ"
