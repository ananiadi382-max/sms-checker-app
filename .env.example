# Скопируйте этот файл в .env и впишите свои реальные данные.
# Файл .env НЕ должен попадать в Git (он уже в .gitignore).
# На Streamlit Cloud эти же значения нужно будет ввести вручную в интерфейсе -
# .env там не используется, но можно оставить поля пустыми и вводить логин/ключ прямо в приложении.

SMSC_LOGIN=
SMSC_API_KEY=
